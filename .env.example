# ============================================================
#  JARVIS Konfiguration
# ============================================================

# --- Login ---
SECRET_KEY=change-this-to-a-random-string
USER_PASSWORD=your-jarvis-password

# --- KI-Gehirn (WICHTIG für schnelle Antworten!) ---
# Groq ist KOSTENLOS und antwortet in 1-2 Sekunden mit einem 70B-Modell.
# Ohne diesen Key fällt Jarvis auf dein lokales Ollama zurück, das auf
# schwacher Hardware 30-60 Sekunden braucht.
#
# Key holen (2 Minuten, gratis): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Lokales LLM (Fallback, falls kein Internet / kein Groq-Key) ---
OLLAMA_URL=http://host.docker.internal:11434
# qwen2.5:3b passt in 6GB GPU und ist schnell. Bei stärkerer GPU: qwen2.5:7b
OLLAMA_MODEL=qwen2.5:3b
# Sekunden, bevor Ollama aufgibt (damit es bei Problemen nicht ewig hängt)
OLLAMA_TIMEOUT=20

# --- Sprache ---
WHISPER_MODEL=base
# Edge-TTS Stimme (kostenlos, natürlich). Alternativen:
#   de-DE-SeraphinaMultilingualNeural (sehr natürlich, weiblich)
#   de-DE-FlorianMultilingualNeural  (sehr natürlich, männlich)
#   de-DE-KatjaNeural / de-DE-ConradNeural (klassisch, robust)
TTS_VOICE=de-DE-SeraphinaMultilingualNeural
TTS_RATE=+0%
